@{ViewData["Title"]="AutoCar Workspace";var module=(string)ViewBag.Module;var isAdmin=User.IsInRole("Admin");}
<div class="admin-shell" id="admin-app" data-module="@module" data-role="@(isAdmin?"Admin":"Sales")"><aside class="admin-sidebar"><p class="eyebrow">AUTOCAR WORKSPACE</p><h3>@(isAdmin?"Điều hành showroom":"Không gian Sales")</h3><nav>@foreach(var item in new[]{("dashboard","◈","Tổng quan"),("cars","◇","Ô tô"),("brands","◎","Hãng xe"),("models","▤","Dòng xe"),("orders","▣","Đơn đặt xe"),("bookings","◷","Lịch lái thử"),("quotes","◌","Tư vấn & báo giá"),("users","♙","Khách hàng & nhân viên"),("reports","↗","Báo cáo doanh thu"),("contacts","✉","Liên hệ"),("audit","≡","Nhật ký hoạt động")}){@if(isAdmin||new[]{"dashboard","orders","bookings","quotes"}.Contains(item.Item1)){<a href="/admin/@item.Item1" class="@(module==item.Item1?"active":"")"><span>@item.Item2</span>@item.Item3</a>}}</nav><div class="sidebar-note">Dữ liệu từ AutoCar.Api<br />SQL Server · Identity · JWT</div></aside><section class="admin-main"><div class="admin-topbar"><div><div class="breadcrumb">Workspace / <span id="module-name">@module</span></div><h1 id="admin-title">Đang tải…</h1></div><div class="admin-user"><span class="avatar">@User.Identity?.Name?[..1]</span><div>@User.Identity?.Name<small>@(isAdmin?"Administrator":"Sales Consultant")</small></div></div></div><div id="admin-toolbar" class="admin-toolbar"></div><div id="admin-content" aria-live="polite">Đang kết nối API…</div></section></div>
<dialog id="admin-dialog" class="app-dialog wide-dialog"><button class="dialog-close" data-close aria-label="Đóng">×</button><div id="admin-dialog-body"></div></dialog>
@section Scripts {<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js" defer></script><script src="/js/admin.js" asp-append-version="true" defer></script>}
