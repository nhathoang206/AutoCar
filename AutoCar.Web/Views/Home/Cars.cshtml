@model AutoCar.Web.ViewModels.CatalogVm
@{ViewData["Title"]="Bộ sưu tập ô tô";}
<div class="page-heading"><div class="container"><div class="breadcrumb"><a href="/">Trang chủ</a> / Bộ sưu tập</div><p class="eyebrow">YOUR NEXT CHAPTER</p><h1>Tìm chiếc xe <em>của bạn.</em></h1><p>Mỗi lựa chọn, một hành trình mới. Giá và thông số trong showroom là dữ liệu minh họa.</p></div></div>
<section class="container section catalog-layout"><aside><form class="filter-panel" action="/xe"><h3>Tinh chỉnh lựa chọn</h3><label>Tìm kiếm<input name="Search" value="@Model.Query.Search" placeholder="Tên xe, dòng xe..." /></label><label>Thương hiệu<select name="BrandId"><option value="">Tất cả</option>@foreach(var b in Model.Brands.Items){<option value="@b.Id" selected="@(Model.Query.BrandId==b.Id)">@b.Name</option>}</select></label><div class="two-columns"><label>Giá từ<input type="number" name="MinPrice" min="0" value="@Model.Query.MinPrice" placeholder="VNĐ" /></label><label>Giá đến<input type="number" name="MaxPrice" min="0" value="@Model.Query.MaxPrice" placeholder="VNĐ" /></label></div><label>Năm sản xuất<input type="number" name="Year" min="1990" max="2100" value="@Model.Query.Year" placeholder="Tất cả" /></label><label>Số chỗ<select name="Seats"><option value="">Tất cả</option>@foreach(var n in new[]{4,5,7,8}){<option selected="@(Model.Query.Seats==n)" value="@n">@n chỗ</option>}</select></label>
@foreach(var field in new[]{("Fuel","Nhiên liệu",new[]{"Xăng","Dầu","Hybrid","Điện"}),("Transmission","Hộp số",new[]{"Tự động","Số sàn"}),("BodyStyle","Kiểu dáng",new[]{"Sedan","SUV","Crossover","Hatchback","Pickup"})}){<label>@field.Item2<select name="@field.Item1"><option value="">Tất cả</option>@foreach(var v in field.Item3){<option selected="@(Context.Request.Query[field.Item1]==v)" value="@v">@v</option>}</select></label>}
<label>Tồn kho<select name="InStock"><option value="">Tất cả</option><option value="true" selected="@(Model.Query.InStock==true)">Còn hàng</option><option value="false" selected="@(Model.Query.InStock==false)">Đặt trước</option></select></label><label>Sắp xếp<select name="Sort"><option value="newest">Mới nhất</option><option value="price_asc" selected="@(Model.Query.Sort=="price_asc")">Giá tăng dần</option><option value="price_desc" selected="@(Model.Query.Sort=="price_desc")">Giá giảm dần</option></select></label><button class="btn primary">Áp dụng bộ lọc</button><a class="text-button" href="/xe">Đặt lại</a></form></aside><div><div class="results-header"><strong>@Model.Cars.Total lựa chọn dành cho bạn</strong><span>Trang @Model.Cars.Page</span></div><div class="car-grid catalog-grid">@foreach(var c in Model.Cars.Items){<partial name="_CarCard" model="c" />}</div>@if(Model.Cars.Items.Count==0){<div class="empty-state"><h3>Chưa có xe phù hợp.</h3><p>Thử thay đổi bộ lọc để khám phá thêm.</p><a href="/xe" class="btn">Xem tất cả xe</a></div>}<nav class="pagination" aria-label="Phân trang">@for(var p=1;p<=Math.Ceiling(Model.Cars.Total/(double)Model.Cars.PageSize);p++){var query=Context.Request.Query.ToDictionary(x=>x.Key,x=>(string?)x.Value.ToString());query["Page"]=p.ToString();<a class="@(p==Model.Cars.Page?"active":"")" href="@Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/xe",query)">@p</a>}</nav></div></section>
