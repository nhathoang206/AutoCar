@inject AutoCar.Web.Services.CarPhotoCatalog Photos
@model AutoCar.Web.ViewModels.DetailVm
@{var c=Model.Car;ViewData["Title"]=$"{c.DisplayName} · {c.Price:N0} VNĐ";ViewData["Description"]=c.Description;var imgs=c.Images.Length>0?c.Images.Select(x=>"/media"+x).ToArray():new[]{Photos.Image(c)};}
<section class="container section"><div class="breadcrumb"><a href="/">Trang chủ</a> / <a href="/xe">Ô tô</a> / @c.Brand @c.Model</div><div class="detail-grid"><div><div class="gallery-main"><button class="gallery-zoom" data-fullscreen aria-label="Xem ảnh toàn màn hình">⛶</button><img id="main-car-image" src="@imgs[0]" alt="@c.DisplayName – hình minh họa" onerror="this.onerror=null;this.src='/images/car-pending.svg'" /></div><div class="gallery-thumbs">@foreach(var img in imgs){<button data-gallery="@img"><img src="@img" alt="Ảnh @c.DisplayName" /></button>}</div><p class="fine-print">Hình ảnh, giá và thông số minh họa phục vụ đồ án.</p></div><div class="detail-summary"><p class="eyebrow">@c.Brand · @c.Year</p><h1>@c.Brand @c.Model</h1><p>@c.Name</p><span class="badge-soft">@(c.Stock>0?$"Còn {c.Stock} xe":"Liên hệ đặt trước")</span><div class="detail-price">@c.Price.ToString("N0") <small>VNĐ</small></div><div class="detail-quick"><span>@c.Fuel</span><span>@c.Transmission</span><span>@c.Seats chỗ</span></div><button class="btn primary" data-open="order-form">Đặt xe của bạn ↗</button><button class="btn" data-open="booking-form">Đặt lịch lái thử</button><button class="text-button" data-open="quote-form">Yêu cầu báo giá & tư vấn →</button><div class="detail-bottom"><button class="text-button" data-favorite="@c.Id">♡ Lưu yêu thích</button><button class="text-button" data-compare="@c.Id">＋ So sánh xe</button></div></div></div>
@if(ViewBag.Has360 == true){
<section class="car360" id="car360" data-style="@c.BodyStyle" data-seed="@c.Id">
<div class="section-top"><div><p class="eyebrow">EXPLORE EVERY ANGLE</p><h2>@c.Brand @c.Model · 360°</h2></div><span class="badge-soft">3D minh họa</span></div>
<canvas tabindex="0" role="img" aria-label="Mô hình xe 3D minh họa. Kéo hoặc dùng phím mũi tên để xoay."></canvas>
<div class="spin-controls"><button type="button" class="btn" data-spin-step="-15" aria-label="Xoay trái">←</button><button type="button" class="btn" data-spin-play aria-pressed="false">Tự động xoay</button><button type="button" class="btn" data-spin-reset>Đặt lại</button><button type="button" class="btn" data-spin-step="15" aria-label="Xoay phải">→</button></div>
<label class="spin-angle">Góc nhìn <input type="range" min="0" max="359" value="35" aria-label="Góc xoay xe" /><output>35°</output></label>
<p class="fine-print">Kéo để xoay 360° · Cuộn để thu phóng. Mô hình mô phỏng kiểu dáng, không phải bản dựng chính xác của dòng xe.</p>
</section>
}
@if(c.Images.Length==0||c.Images[0].StartsWith("/catalog/")){@if(Photos.Find(c.Brand,c.Model) is {} credit){<p class="fine-print photo-credit">Ảnh: @credit.Artist · <a href="@credit.Source" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a> · <a href="@credit.LicenseUrl" target="_blank" rel="noopener noreferrer">@credit.License</a>. Ảnh tham khảo dòng xe, có thể khác năm, phiên bản và thị trường; đã thu nhỏ và chuyển WebP.</p>}}
<div class="detail-tabs"><a href="#specifications">Thông số</a><a href="#description">Trang bị & mô tả</a><a href="#finance">Ước tính trả góp</a><a href="#reviews">Đánh giá</a></div><div class="detail-lower"><section id="specifications"><p class="eyebrow">IN THE DETAILS</p><h2>Thông số kỹ thuật.</h2><dl class="spec-table">@foreach(var spec in new[]{("Thương hiệu",c.Brand),("Dòng xe",c.Model),("Phiên bản",c.Name),("Năm sản xuất",c.Year.ToString()),("Kiểu dáng",c.BodyStyle),("Xuất xứ",c.Origin),("Số chỗ",c.Seats.ToString()),("Nhiên liệu",c.Fuel),("Động cơ",c.Engine),("Công suất",c.Power),("Mô-men xoắn",c.Torque),("Hộp số",c.Transmission),("Dẫn động",c.Drivetrain),("Màu sắc",c.Colors),("Kích thước",c.Dimensions),("Tiêu hao / Phạm vi",c.Consumption)}){<div><dt>@spec.Item1</dt><dd>@spec.Item2</dd></div>}</dl></section><section id="description"><p class="eyebrow">CRAFTED FOR YOU</p><h2>Trang bị & trải nghiệm.</h2><p class="description-text">@c.Description</p></section></div>
<section id="finance" class="finance-box"><div><p class="eyebrow">PLAN YOUR JOURNEY</p><h2>Chủ động kế hoạch tài chính.</h2><p>Mô phỏng khoản vay trả góp theo dư nợ giảm dần với khoản trả đều. Lãi suất giả định, không phải cam kết tín dụng.</p></div><form id="finance-form"><label>Giá xe (VNĐ)<input name="price" type="number" value="@c.Price.ToString("0",System.Globalization.CultureInfo.InvariantCulture)" min="1" required /></label><label>Trả trước (%)<input name="down" type="number" value="30" min="0" max="100" required /></label><label>Thời hạn (tháng)<input name="months" type="number" value="60" min="1" max="360" required /></label><label>Lãi suất (%/năm)<input name="rate" type="number" step="0.1" value="8" min="0" max="50" required /></label><button class="btn primary">Tính khoản trả hàng tháng</button><output id="finance-result" aria-live="polite"></output></form></section>
<section id="reviews" class="section"><h2>Góc nhìn từ người sở hữu.</h2><div id="reviews-list" data-car="@c.Id" class="remote-list">Đang tải đánh giá…</div>@if(User.IsInRole("Customer")){<form class="api-form panel" data-endpoint="reviews"><input type="hidden" name="carId" value="@c.Id" data-number /><label>Đánh giá<select name="rating" data-number><option value="5">5 sao</option><option value="4">4 sao</option><option value="3">3 sao</option><option value="2">2 sao</option><option value="1">1 sao</option></select></label><label>Chia sẻ trải nghiệm<textarea name="comment" required maxlength="2000"></textarea></label><p class="fine-print">Chỉ khách hàng đã hoàn tất mua xe được đánh giá.</p><button class="btn primary">Gửi đánh giá</button></form>}</section>
<section class="section"><div class="section-top"><h2>Cùng phong cách, thêm lựa chọn.</h2><a href="/xe?BrandId=@c.BrandId">Xem thêm ↗</a></div><div class="car-grid">@foreach(var related in Model.Related.Items.Where(x=>x.Id!=c.Id).Take(3)){<partial name="_CarCard" model="related" />}</div></section></section>
@foreach(var form in new[]{("order-form","orders","Đặt xe",true),("booking-form","test-drive-bookings","Đặt lịch lái thử",false),("quote-form","quote-requests","Yêu cầu báo giá",false)}){<dialog id="@form.Item1" class="app-dialog"><button class="dialog-close" data-close aria-label="Đóng">×</button><p class="eyebrow">AUTOCAR CONCIERGE</p><h2>@form.Item3</h2><p>@c.Brand @c.Model · @c.Price.ToString("N0") VNĐ (minh họa)</p>@if(User.IsInRole("Customer")){<form class="api-form" data-endpoint="@form.Item2"><input name="carId" value="@c.Id" type="hidden" data-number />@if(form.Item4){<label>Số lượng<input type="number" name="quantity" value="1" min="1" max="5" data-number required /></label><label>Ghi chú<textarea name="note" maxlength="1000"></textarea></label><p class="fine-print">Yêu cầu chưa giữ tồn kho. Nhân viên sẽ xác nhận tình trạng xe và liên hệ thanh toán thủ công.</p>}else{<label>Số điện thoại<input name="phone" type="tel" required maxlength="20" /></label>@if(form.Item1=="booking-form"){<label>Thời gian<input type="datetime-local" name="scheduledAt" required /></label><label>Ghi chú<textarea name="note" maxlength="1000"></textarea></label>}else{<label>Nội dung tư vấn<textarea name="message" maxlength="1000"></textarea></label>}}<button class="btn primary">Gửi yêu cầu ↗</button></form>}else{<p>Vui lòng đăng nhập tài khoản khách hàng để tiếp tục.</p><a href="/dang-nhap" class="btn primary">Đăng nhập</a>}</dialog>}
