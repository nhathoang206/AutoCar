@model AutoCar.Shared.Contracts.RegisterInput
@{ViewData["Title"]="Tham gia AutoCar";}
<section class="auth-page"><div class="auth-art"><p class="eyebrow light">BELONG TO THE JOURNEY</p><h2>Lựa chọn của bạn.<br />Hành trình của riêng bạn.</h2><img src="/images/showroom-hero.webp" alt="Ô tô minh họa" /><span>AUTOCAR · THE NEXT CHAPTER</span></div><div class="auth-form"><p class="eyebrow">CREATE YOUR ACCOUNT</p><h1>Khởi đầu cùng AutoCar.</h1><form method="post" action="/dang-ky">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation-errors" role="alert"></div><label>Họ và tên<input asp-for="FullName" required autocomplete="name" /></label><label>Email<input asp-for="Email" type="email" required autocomplete="email" /></label><label>Số điện thoại<input asp-for="Phone" type="tel" autocomplete="tel" /></label><label>Mật khẩu<input asp-for="Password" type="password" required minlength="10" autocomplete="new-password" /></label><p class="fine-print">Tối thiểu 10 ký tự, có chữ hoa, chữ thường, chữ số và ký tự đặc biệt.</p><button class="btn primary">Tạo tài khoản ↗</button></form><p>Đã có tài khoản? <a href="/dang-nhap">Đăng nhập</a></p></div></section>
